# hpcctl environment contract -- copy to .env, fill in, and `source` it.
#
#   cp hpcctl/.env.example hpcctl/.env && $EDITOR hpcctl/.env && set -a && . hpcctl/.env && set +a
#
# hpcctl does NOT auto-load .env. Auto-loading a hidden file makes the resolved config
# non-obvious, which is a bad property for a tool that spends money -- you source it.
#
# Every value here is a PLACEHOLDER. Nothing real belongs in this file: it is the one config
# artifact the root .gitignore un-ignores, so anything written here WILL be committed.
# Real values live only in .env (ignored) or your shell.
#
# "R" marks values required for live execution;
# unset values become <<<UNSET:NAME>>> placeholders in dry-run and hard-fail (exit 3) with
# --execute.

# ---------------------------------------------------------------------------
# Identity and region
# ---------------------------------------------------------------------------
HPCCTL_CLUSTER_NAME=hpc-dag-baseline
# R -- AWS_DEFAULT_REGION is consulted as a fallback.
AWS_REGION=us-east-1

# ---------------------------------------------------------------------------
# Head node and networking
# ---------------------------------------------------------------------------
# ubuntu2404, not the ubuntu2204 default: engine binaries are compiled on the dev box
# (Ubuntu 24.04) and rsync'd to the cluster by `deploy`, so the cluster's glibc must not be
# older than the dev box's or the binary will not run. Keep this in lockstep with the OS you
# actually build on.
HPCCTL_OS=ubuntu2404
# R -- the EC2 key pair NAME, not a path to a .pem file.
HPCCTL_KEY_NAME=my-keypair
# R
HPCCTL_HEAD_SUBNET_ID=subnet-00000000000000000
# Defaults to HPCCTL_HEAD_SUBNET_ID when unset.
HPCCTL_COMPUTE_SUBNET_ID=subnet-00000000000000000
HPCCTL_HEAD_INSTANCE_TYPE=t3.medium

# ---------------------------------------------------------------------------
# Compute fleet
# ---------------------------------------------------------------------------
HPCCTL_COMPUTE_INSTANCE_TYPE=c5.large
HPCCTL_QUEUE_NAME=compute
HPCCTL_MIN_NODES=0
HPCCTL_MAX_NODES=16

# ---------------------------------------------------------------------------
# Shared filesystem -- deploy's target and the cluster mount point must agree,
# or jobs run on the head node and fail on every compute node.
# ---------------------------------------------------------------------------
HPCCTL_SHARED_DIR=/shared
HPCCTL_SHARED_VOLUME_GB=50

# ---------------------------------------------------------------------------
# Bootstrap script publication -- nodes fetch the script from S3 at configure time.
# ---------------------------------------------------------------------------
# R
HPCCTL_BOOTSTRAP_BUCKET=my-bootstrap-bucket
HPCCTL_BOOTSTRAP_PREFIX=hpcctl/bootstrap

# ---------------------------------------------------------------------------
# SSH access -- used by deploy, submit, status, and result.
# Only the key's PATH is ever read or printed; its contents never are.
# ---------------------------------------------------------------------------
# LEAVE HPCCTL_HEAD_NODE_HOST UNSET. The head node gets a fresh IP on every boot, and live
# commands discover the current address from the cluster automatically. Set it only to pin a
# specific address (e.g. a private IP over a VPN) -- an explicit value always wins.
# HPCCTL_HEAD_NODE_HOST=
HPCCTL_SSH_USER=ubuntu
HPCCTL_SSH_KEY_PATH=~/.ssh/hpc-dag-key-ed25519.pem

# ---------------------------------------------------------------------------
# Engine layout
# ---------------------------------------------------------------------------
# Defaults to <repo>/engine/build, located from the installed package rather than the working
# directory, so deploy works from anywhere in the repo. Only bin/ inside it is synced.
# Set this only for an out-of-tree build.
# HPCCTL_ENGINE_BUILD_DIR=
# Defaults to ${HPCCTL_SHARED_DIR}/engine.
HPCCTL_REMOTE_ENGINE_DIR=/shared/engine
# Defaults to ${HPCCTL_SHARED_DIR}/dags.
HPCCTL_REMOTE_DAG_DIR=/shared/dags
# Defaults to ${HPCCTL_REMOTE_ENGINE_DIR}/bin/engine.
HPCCTL_ENGINE_BINARY=/shared/engine/bin/engine

# ---------------------------------------------------------------------------
# Default job geometry. Ranks are always nodes+1 (scheduler co-located with one worker);
# use `submit --ntasks` for irregular experiments. CLI flags override per experiment.
# ---------------------------------------------------------------------------
HPCCTL_NODES=1
HPCCTL_TIME_LIMIT=00:30:00
# Where sbatch/squeue live on the head node. Referenced by absolute path because the
# non-interactive shells `ssh <host> <cmd>` spawns never source the profile that puts Slurm
# on PATH (first live submit failed with "sbatch: command not found" without this).
HPCCTL_SLURM_BIN=/opt/slurm/bin

# ---------------------------------------------------------------------------
# Local paths and global switches
# ---------------------------------------------------------------------------
# Defaults to the repository's shared/dag_schema.json, found from the installed package, so it
# works from any working directory. Set only to test an alternative contract.
# HPCCTL_SCHEMA_PATH=

HPCCTL_RUN_DIR=./.hpcctl-run

# Global kill switch. Set to any non-empty value to force dry-run everywhere, defeating
# --execute. Leave unset for normal operation; set it while nobody should be spending money.
# HPCCTL_DRY_RUN=1
